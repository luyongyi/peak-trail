{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/peaktrail/daily-map.schema.json",
  "title": "PEAK daily map observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fetchedAtUtc",
    "nextChangeAtUtc",
    "source",
    "apiVersion",
    "versionOkay",
    "levelIndex",
    "mapCount",
    "mapSlot",
    "sceneName",
    "secondsRemaining",
    "message"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fetchedAtUtc": { "type": "string", "format": "date-time" },
    "nextChangeAtUtc": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "format": "uri" },
    "apiVersion": { "type": "string" },
    "versionOkay": { "type": "boolean" },
    "levelIndex": { "type": "integer" },
    "mapCount": { "type": "integer", "minimum": 1 },
    "mapSlot": { "type": "integer", "minimum": 0 },
    "sceneName": { "type": "string" },
    "secondsRemaining": { "type": "integer", "minimum": 0 },
    "message": { "type": "string" }
  }
}

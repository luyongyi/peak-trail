<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PeakTrail.PeakMapExporter</AssemblyName>
    <AssemblyTitle>PeakMapExporter</AssemblyTitle>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCoreDir)BepInEx.dll" Private="false" />
    <GameReference
      Include="$(ManagedDir)*.dll"
      Exclude="$(ManagedDir)Mono*.dll;$(ManagedDir)netstandard.dll;$(ManagedDir)System*.dll;$(ManagedDir)mscorlib.dll"
    />
    <Reference Include="@(GameReference)" Private="false" />
  </ItemGroup>

  <Target Name="EnsurePEAKInstall" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(ManagedDir)Assembly-CSharp.dll')"
      Text="PEAK was not found at '$(PEAKGameRootDir)'. Pass -p:PEAKGameRootDir=... to the build."
    />
    <Error
      Condition="!Exists('$(BepInExCoreDir)BepInEx.dll')"
      Text="BepInEx was not found at '$(BepInExCoreDir)'. Install BepInEx for PEAK first."
    />
  </Target>
</Project>
